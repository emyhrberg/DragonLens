{
  "profiles": {
    "Terraria": {
      "commandName": "Executable",
      "executablePath": "$(DotNetPath)",
      "commandLineArgs": "$(tMLPath)",
      "workingDirectory": "$(tMLSteamPath)"
    },
    "TerrariaServer": {
      "commandName": "Executable",
      "executablePath": "$(DotNetPath)",
      "commandLineArgs": "$(tMLServerPath)",
      "workingDirectory": "$(tMLSteamPath)"
    },
    "TerrariaFast": {
      "commandName": "Executable",
      "executablePath": "$(DotNetPath)",
      "commandLineArgs": "$(tMLPath) -skipselect \"TestPlayer:Spawnbox\"",
      "workingDirectory": "$(tMLSteamPath)"
    }
  }
}
